# LocalStack AWS Emulation Endpoint
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_CONTAINER=localstack
AWS_DEFAULT_REGION=us-east-1

# Defender SIEM & Dashboard Server
DEFENDER_URL=http://localhost:8000
DEFENDER_HOST=0.0.0.0
DEFENDER_PORT=8000

# Simulated Honeypot / Canary Credentials
LEAKED_ACCESS_KEY=CANARY_KEY_ID_DEMO_123
LEAKED_SECRET_KEY=demoLeakedSecretKeyValueNotReal1234567890
